# ===== Bun / Node 依赖 =====
node_modules/
.bun-cache/

# ===== 构建产物 =====
dist/
out/
*.tsbuildinfo
# 但是！server/public/ 下的 vendor 库（vue/vuetify/...）也叫 dist/
# 这些是要入仓的，否则别的机器拉下来跑不起来
!server/public/**/dist/
!server/public/**/dist/**

# ===== 环境变量（含密码，不入仓）=====
.env
.env.local
.env.*.local

# ===== 上传文件不入仓（保留 .gitkeep 占位）=====
server/uploads/*
!server/uploads/.gitkeep

# ===== Vant 自动生成的类型文件 =====
web/src/components.d.ts

# ===== Office 临时锁文件 =====
~$*

# ===== IDE / 系统垃圾文件 =====
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini
*.log
.cache/
