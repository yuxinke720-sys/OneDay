# 把本文件复制为 .env，再填上你机器上的实际密码
#   Mac/Linux:  cp .env.example .env
#   Windows:    Copy-Item .env.example .env

# ===== 服务器 =====
PORT=3000
NODE_ENV=development

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=         # ← 填你本机 PostgreSQL 的密码
DB_NAME=oneday       # ← 建议改用 oneday，前面的 student_db 是历史遗留
DB_SSL=false
DB_MAX_CONNECTIONS=10

# ===== CORS（生产期收紧）=====
CORS_ORIGIN=*
